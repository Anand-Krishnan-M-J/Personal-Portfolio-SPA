{
  "name": "anand-krishnan-portfolio",
  "private": true,
  "scripts": {
    "dev": "npm run content:prepare && next dev --webpack -p 4001",
    "dev:host": "npm run content:prepare && next dev --webpack --hostname 0.0.0.0 -p 4001",
    "prebuild": "npm run content:prepare",
    "build": "next build --webpack",
    "postbuild": "node scripts/package-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "content:check": "node --import tsx scripts/validate-content.ts",
    "content:generate": "node --import tsx scripts/generate-site-files.ts && node scripts/generate-og-card.mjs",
    "content:prepare": "npm run content:check && npm run content:generate",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "smoke": "node scripts/smoke-standalone.mjs",
    "check": "npm run content:check && npm run lint && npm run typecheck && npm test && npm run format:check",
    "verify": "npm run check && npm run build && npm run bundle:check && npm run smoke && git diff --exit-code -- content/site-metadata.generated.json public/og.png public/sitemap.xml public/robots.txt",
    "prepare": "node scripts/setup-husky.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --fix",
    "*.{css,scss,json,md}": "prettier --write"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.6.1",
    "next": "16.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "sass": "^1.102.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.9.2"
  },
  "packageManager": "npm@10.9.2"
}
